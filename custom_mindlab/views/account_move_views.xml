<odoo>

    <record id="inherit_account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="register_id"  invisible="register_id == False"  string='Admission Register'/>

            </xpath>

              <xpath expr="//button[@name='action_post']" position="after">
                    <button name="action_view_admission_register"
                        string="View Admission Register"
                        type="object"/>

            </xpath>

        </field>
    </record>

</odoo>