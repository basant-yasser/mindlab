<odoo>

    <record id="inherit_op_student_view_form" model="ir.ui.view">
        <field name="name">op.student.view.form.inherit</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="state" widget="statusbar" statusbar_visible="active,inactive,withdrawn,graduated"/>
            </xpath>

              <xpath expr="//button[@name='get_parent']" position="after">
                <div class="oe_button_box" name="button_box">
                    <button type="object" class="oe_stat_button"
                            icon="fa-newspaper-o"
                            name="action_view_student_applications"
                            >
                        <div class="o_form_field o_stat_info">
                            <span class="o_stat_text">Applications</span>
                        </div>
                    </button>
                </div>
            </xpath>


            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="whatsapp_number"/>
                <field name="registration_source"/>
                <field name="op_course_id"/>
                <field name="number_of_sessions"/>

            </xpath>
            <xpath expr="//field[@name='emergency_contact']" position="after">
                <field name="parent_ids" widget="many2many_tags"/>
                <field name="relationship_id"/>
            </xpath>


            <xpath expr="//notebook/page[@name='other_information']" position="after">
                <page string="Previous Levels" name="previous_levels">

                    <field name="academic_year_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </list>
                    </field>
                </page>
                 <page string="Student Attendance Sheet" name="student_attendance_sheet">
                    <field name="student_attendance_sheet_ids">
                        <list editable="bottom">
                            <field name="course_name"/>
                            <field name="number_of_sessions"/>
                            <field name="remaining_of_sessions"/>
                            <field name="start_date"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>