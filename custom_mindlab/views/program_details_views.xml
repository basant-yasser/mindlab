<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="program_details_list" model="ir.ui.view">
            <field name="name">program.details.list</field>
            <field name="model">program.details</field>
            <field name="arch" type="xml">
                <list  editable="bottom" multi_edit="1">

                    <field name="kit_type_id"/>
                    <field name="kit_level_id"/>
                    <field name="project_program_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>



        <record id="program_details_act_window" model="ir.actions.act_window">
            <field name="name">Program Details</field>
            <field name="res_model">program.details</field>
        </record>

        <menuitem action="program_details_act_window" id="menu_program_details_act_window" parent="openeducat_timetable.menu_op_timetable_configuration" sequence="2"/>
    </data>
</odoo>
