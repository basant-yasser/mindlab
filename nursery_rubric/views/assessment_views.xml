<odoo>
  <record id="view_nursery_assessment_tree" model="ir.ui.view">
    <field name="name">nursery.assessment.tree</field>
    <field name="model">nursery.assessment</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date"/>
        <field name="student_id"/>
        <field name="teacher_id"/>
        <field name="rubric_id"/>
        <field name="total_score"/>
        <field name="performance_level"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="view_nursery_assessment_form" model="ir.ui.view">
    <field name="name">nursery.assessment.form</field>
    <field name="model">nursery.assessment</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_submit" type="object" string="Submit"  invisible="state != 'draft'" class="btn-primary"/>
          <button name="action_approve" type="object" string="Approve" invisible="state !=  'submitted'" class="btn-primary"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
        </header>

        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>

          <group>
            <group>
              <field name="date"/>
              <field name="student_id"/>
              <field name="rubric_id"/>
            </group>
            <group>
              <field name="teacher_id" readonly="1"/>
              <field name="total_score" readonly="1"/>
              <field name="performance_level" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Rubric">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="criterion_name"/>
                  <field name="weight"/>
                  <field name="score"/>
                  <field name="weighted_score" readonly="1"/>
                  <field name="notes"/>
                </list>
                <form>
                  <group>
                    <field name="criterion_name" readonly="1"/>
                    <field name="weight" readonly="1"/>
                    <field name="score"/>
                    <field name="weighted_score" readonly="1"/>
                    <field name="notes"/>
                  </group>
                  <group string="Level Descriptions">
                    <field name="level_1" readonly="1"/>
                    <field name="level_2" readonly="1"/>
                    <field name="level_3" readonly="1"/>
                    <field name="level_4" readonly="1"/>
                  </group>
                </form>
              </field>
            </page>
          </notebook>
        </sheet>

        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_nursery_assessment" model="ir.actions.act_window">
    <field name="name">Assessments</field>
    <field name="res_model">nursery.assessment</field>
    <field name="view_mode">list,form,pivot,graph</field>
  </record>

  <record id="action_nursery_rubric" model="ir.actions.act_window">
    <field name="name">Rubrics</field>
    <field name="res_model">nursery.rubric</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_nursery_root" name="Nursery"/>
  <menuitem id="menu_nursery_assessments" name="Assessments" parent="menu_nursery_root" action="action_nursery_assessment"/>
  <menuitem id="menu_nursery_rubrics" name="Rubrics" parent="menu_nursery_root" action="action_nursery_rubric"/>
</odoo>
