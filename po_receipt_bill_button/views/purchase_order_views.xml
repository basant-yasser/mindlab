<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_bill_credit_buttons" model="ir.ui.view">
        <field name="name">purchase.order.form.bill.credit.buttons</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_create_bill_or_credit_note"
                    type="object"
                    string="Create Bill"
                    class="oe_highlight"
                    invisible="not show_create_bill_button"
                />
                <button
                    name="action_create_bill_or_credit_note"
                    type="object"
                    string="Create Credit Note"
                    class="oe_highlight"
                    invisible="not show_create_credit_note_button"
                />
            </xpath>
        </field>
    </record>
</odoo>
