<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mindlab_student_evaluation_list" model="ir.ui.view">
        <field name="name">mindlab.student.evaluation.list</field>
        <field name="model">mindlab.student.evaluation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="evaluation_date"/>
                <field name="student_id"/>
                <field name="offer_id"/>
                <field name="teacher_id"/>
                <field name="total_score"/>
                <field name="result"/>
                <field name="progressed"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mindlab_student_evaluation_form" model="ir.ui.view">
        <field name="name">mindlab.student.evaluation.form</field>
        <field name="model">mindlab.student.evaluation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object" string="Mark Done" class="oe_highlight" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="student_id"/>
                            <field name="enrollment_id"/>
                            <field name="offer_id"/>
                            <field name="evaluation_template_id"/>
                        </group>
                        <group>
                            <field name="evaluation_date"/>
                            <field name="teacher_id"/>
                            <field name="total_score" readonly="1"/>
                            <field name="result" readonly="1"/>
                        </group>
                    </group>
                    <group string="Progression">
                        <field name="stage_from_id"/>
                        <field name="progressed"/>
                        <field name="stage_to_id" invisible="not progressed"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="criterion"/>
                            <field name="score"/>
                            <field name="max_score"/>
                            <field name="remarks"/>
                        </list>
                    </field>
                    <group>
                        <field name="recommendation"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mindlab_student_evaluation_search" model="ir.ui.view">
        <field name="name">mindlab.student.evaluation.search</field>
        <field name="model">mindlab.student.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_mindlab_student_evaluations" model="ir.actions.act_window">
        <field name="name">Evaluations</field>
        <field name="res_model">mindlab.student.evaluation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
