<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mindlab_stage_list" model="ir.ui.view">
        <field name="name">mindlab.stage.list</field>
        <field name="model">mindlab.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mindlab_stage_form" model="ir.ui.view">
        <field name="name">mindlab.stage.form</field>
        <field name="model">mindlab.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mindlab_stage_search" model="ir.ui.view">
        <field name="name">mindlab.stage.search</field>
        <field name="model">mindlab.stage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>


    <record id="action_mindlab_stages" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">mindlab.stage</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
