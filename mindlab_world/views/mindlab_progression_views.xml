<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mindlab_progression_list" model="ir.ui.view">
        <field name="name">mindlab.progression.list</field>
        <field name="model">mindlab.student.progression</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="student_id"/>
                <field name="from_stage_id"/>
                <field name="to_stage_id"/>
                <field name="reason"/>
                <field name="evaluation_id"/>
            </list>
        </field>
    </record>

    <record id="action_mindlab_progressions" model="ir.actions.act_window">
        <field name="name">Progression History</field>
        <field name="res_model">mindlab.student.progression</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
