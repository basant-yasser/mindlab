<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mindlab_category_list" model="ir.ui.view">
        <field name="name">mindlab.category.list</field>
        <field name="model">mindlab.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mindlab_category_form" model="ir.ui.view">
        <field name="name">mindlab.category.form</field>
        <field name="model">mindlab.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_mindlab_categories" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">mindlab.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
