<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_mindlab_world" model="ir.ui.view">
        <field name="name">account.move.form.mindlab.world</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="mindlab_student_id"/>
                <field name="mindlab_enrollment_id"/>
            </xpath>
        </field>
    </record>

    <record id="action_mindlab_invoices" model="ir.actions.act_window">
        <field name="name">Mindlab Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type','=','out_invoice'), ('mindlab_student_id','!=',False)]</field>
        <field name="context">{'default_move_type':'out_invoice'}</field>
    </record>
</odoo>
