<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mindlab_session_log_list" model="ir.ui.view">
        <field name="name">mindlab.session.log.list</field>
        <field name="model">mindlab.session.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="student_id"/>
                <field name="enrollment_id"/>
                <field name="action_type"/>
                <field name="qty"/>
                <field name="before_remaining"/>
                <field name="after_remaining"/>
                <field name="reason"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="action_mindlab_session_logs" model="ir.actions.act_window">
        <field name="name">Session Logs</field>
        <field name="res_model">mindlab.session.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
